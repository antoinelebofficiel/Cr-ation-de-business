# Google Cloud Console → APIs & Services → Credentials → Create API key
# Enable: Places API (New)
# Billing must be active on the project
GOOGLE_PLACES_API_KEY=your_api_key_here

# Optionnel — push direct vers Google Sheets CRM
# 1) Créer un Service Account + activer Sheets API + Drive API
# 2) Partager la Sheet avec l'email du service account (Éditeur)
# 3) Télécharger le JSON et le mettre hors git
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
GOOGLE_SHEET_ID=
